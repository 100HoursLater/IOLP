;; IOL : Parenthesized-Instruction-Oriented-Lisp Spec

;; instructional function
(myInstruction(): 
  (struct t[]:
   _var: _int : i = 1,
  end :-t),
 (instruct[:-i += 2]),
 (instruct[
  if_conditional(:-i == 2):
   print("My i equals", :-conditional)
  end :-if_conditional
 ]),
 (#return: {})

 (end :-myInstruction())
).

; operator list

== ; comparison 
= ; assignment
+= ; compound assignment (addition)
-= ; compound assignment (subtraction)
<= ; less than equals
>= ; more than equals

- ; subtraction
+ ; addition
* ; multiply
/ ; division 
> ; more than 
< ; less than
++ ; iterator up
-- ; iterator down
% ; modulo
 
:- ; reference
. ; function end 
end ; ends something
#return ; returns

; for loop

for(_var _int : U = 1, I <= 100, I++): 
  if_conditional(I % 15 == 0):
      print("FizzBuzz\n")
    end else_conditional(I % 3 == 0):
      print("Fizz\n")
    end else_conditional(I % 5 == 0):
      print("Buzz\n")
    end else: 
      print("\n",I)
  end :-conditional
end :-for

for():
end :-for

; more complex 

(list(
  (list_item(1): var,func),
  (list_item(2): var,func),
  ; and so on
)).

(instruct[
  (generic_point(memoryaddress)),
  (generic_scope(reference)),
  (generic_parameter(param)),
  (object: {}),
])

(defclass <tower> []:
  ((_var: id_reader, _var: _char : tower_id_keyword = []):
   (block[accessor]: 
     tower[]
   )
   (build_tower(x,n):
     labels[(for(i res): conditional:(= i 0): print(:-tower_id_keyword). end :-for)]
    end :-build_tower()
   )
  )
  
)
